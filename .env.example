# Copia este archivo a .env (no lo subas al repo) o configura estas variables en Vercel.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Activa el cálculo de IVA con Stripe Tax cuando tengas domicilio fiscal y registros.
STRIPE_AUTOMATIC_TAX=false
# URL pública del sitio (para volver desde Checkout).
SITE_URL=https://www.ceibalabs.io
# Token largo y aleatorio para /api/publish (uso interno).
CEIBA_ADMIN_TOKEN=

# Embudo: Supabase (guardar solicitudes). La service_role key solo va en el servidor.
SUPABASE_URL=https://emcfsmufhvnekqnmosmx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Correos con Resend: aviso al equipo y confirmación al cliente.
RESEND_API_KEY=
RESEND_FROM=Ceiba Labs <avisos@ceibalabs.io>
# A quién avisar cuando llega una solicitud (varios separados por coma).
CEIBA_NOTIFY_EMAIL=
# Panel /admin y /api/publish: token largo y aleatorio (mínimo 24 caracteres).
# (CEIBA_ADMIN_TOKEN ya está arriba; usa el mismo.)
# Rutina de Claude «Armar propuesta»: id y token del disparador por API (claude.ai › rutina › API).
CLAUDE_ROUTINE_ID=trig_013pC6uxYkCVo6Uv4r5dcqfg
CLAUDE_ROUTINE_TOKEN=
