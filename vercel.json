{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "buildCommand": "",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/geo",
      "destination": "/api/lead?geo=1"
    },
    {
      "source": "/media/:slug/:file",
      "destination": "/api/site?media=:slug/:file"
    },
    {
      "source": "/vista/:slug/:page",
      "destination": "/api/vista?slug=:slug&p=:page"
    },
    {
      "source": "/vista/:slug",
      "destination": "/api/vista?slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/p?slug=:slug"
    },
    {
      "source": "/webs",
      "destination": "/webs.html"
    },
    {
      "source": "/webs/clinicas",
      "destination": "/webs-clinicas.html"
    },
    {
      "source": "/ia",
      "destination": "/ia.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/cuenta/:slug",
      "destination": "/cuenta.html"
    },
    {
      "source": "/cuenta",
      "destination": "/cuenta.html"
    },
    {
      "source": "/maqueta",
      "destination": "/maqueta.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    }
  ],
  "redirects": [
    {
      "source": "/webs-clinicas.html",
      "destination": "/webs/clinicas",
      "permanent": true
    },
    {
      "source": "/propuesta-clinica-arrayan.html",
      "destination": "/p/clinica-arrayan",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/webs.html",
      "destination": "/webs",
      "permanent": true
    },
    {
      "source": "/ia.html",
      "destination": "/ia",
      "permanent": true
    },
    {
      "source": "/diagnostico.html",
      "destination": "/diagnostico",
      "permanent": true
    },
    {
      "source": "/webs/",
      "destination": "/webs",
      "permanent": true
    },
    {
      "source": "/ia/",
      "destination": "/ia",
      "permanent": true
    },
    {
      "source": "/webs/clinicas/",
      "destination": "/webs/clinicas",
      "permanent": true
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 120
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(llms.txt|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin?action=cron",
      "schedule": "17 15 * * *"
    }
  ]
}
